{
  "codeOwnerReview": {
    "owners": [
      "@bartekus"
    ],
    "paths": [
      "/.github/workflows/statecraft-ai-review.yml",
      "/.github/workflows/statecraft-ci.yml",
      "/.statecraft/REVIEW.md",
      "/.statecraft/setup/github-actions-rust.json",
      "/.statecraft/setup/github-actions-rust.remote.json",
      "/Makefile",
      "/scripts/statecraft/ai-review.sh",
      "/scripts/statecraft/ci-gate.sh",
      "/scripts/statecraft/gate.sh",
      "/scripts/statecraft/guard-policy-files.sh",
      "/scripts/statecraft/install-spec-spine.sh",
      "/scripts/statecraft/verify-action-pins.sh"
    ],
    "required": true
  },
  "defaultBranch": "main",
  "extraRequiredJobs": {
    "aggregate": "ci-gate",
    "jobs": [
      {
        "job": "bindings",
        "workflow": ".github/workflows/bindings.yml"
      },
      {
        "job": "boundaries",
        "workflow": ".github/workflows/boundaries.yml"
      },
      {
        "job": "release-checks",
        "workflow": ".github/workflows/release-checks.yml"
      },
      {
        "job": "verify",
        "workflow": ".github/workflows/verify.yml"
      }
    ]
  },
  "mergeQueue": {
    "allEntriesMustPass": true,
    "buildConcurrency": 5,
    "mergeMethod": "squash",
    "required": true
  },
  "profile": {
    "id": "github-actions-rust",
    "identity": "39e2a7a244759e35b35b089449054b69062d619d9d418b94a6e83a2accdd3b88",
    "revision": 26
  },
  "requiredChecks": [
    {
      "appId": 15368,
      "name": "ci-gate"
    }
  ],
  "reviewException": {
    "environment": "statecraft-review-exception",
    "preventSelfReview": true
  },
  "schema": "statecraft/remote-desired-state/1",
  "secrets": [
    {
      "anyOf": [
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN"
      ],
      "visibility": [
        "repository",
        "organization"
      ]
    }
  ],
  "workflowToken": {
    "canApprovePullRequestReviews": false,
    "defaultPermissions": "read"
  }
}
