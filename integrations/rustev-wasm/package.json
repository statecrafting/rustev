{
  "name": "@rustev/rustev-wasm",
  "version": "0.1.0",
  "private": true,
  "description": "Rustev's pure commands as a WebAssembly module: check, compile, show, offline replay, evaluation, gates and calibration.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statecrafting/rustev.git",
    "directory": "integrations/rustev-wasm"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    "./web": {
      "types": "./web/index.d.ts",
      "import": "./web/index.js"
    },
    "./bundler": {
      "types": "./bundler/index.d.ts",
      "import": "./bundler/index.js"
    },
    "./node": {
      "types": "./node/index.d.ts",
      "require": "./node/index.js"
    },
    "./documents": {
      "types": "./types/rustev-documents.d.ts"
    }
  },
  "files": ["web", "bundler", "node", "types"]
}
