{
  "name": "@statecrafting/rustev",
  "version": "0.1.0",
  "private": true,
  "description": "Rustev's Node-API binding: compile plans, run decisions, replay and evaluate in-process, with host-implemented seams.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statecrafting/rustev.git",
    "directory": "integrations/rustev-node"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./documents": {
      "types": "./types/rustev-documents.d.ts"
    }
  },
  "files": ["index.js", "index.d.ts", "types"],
  "optionalDependencies": {
    "@statecrafting/rustev-linux-x64-gnu": "0.1.0",
    "@statecrafting/rustev-linux-x64-musl": "0.1.0",
    "@statecrafting/rustev-linux-arm64-gnu": "0.1.0",
    "@statecrafting/rustev-linux-arm64-musl": "0.1.0",
    "@statecrafting/rustev-darwin-arm64": "0.1.0",
    "@statecrafting/rustev-darwin-x64": "0.1.0",
    "@statecrafting/rustev-win32-x64-msvc": "0.1.0"
  }
}
